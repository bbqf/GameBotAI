<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="GameBot"
    Manufacturer="$(var.InstallerManufacturer)"
    Version="$(var.InstallerVersion)"
    UpgradeCode="B7CA67D4-9DE5-43F5-BE43-EA9A00A3E202"
    Scope="perUser"
    Language="1033"
    InstallerVersion="500">

    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WixUISupportPerUser" Value="1" />
    <Property Id="MSIINSTALLPERUSER" Value="1" Secure="yes" />
    <Property Id="ApplicationFolderName" Value="GameBot" />
    <Property Id="WixAppFolder" Value="WixPerUserFolder" />
    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Run GameBot background app now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="SAME_BUILD_STATUS_CODE" Value="4090" />

    <CustomAction
      Id="LaunchBackgroundApp"
      Directory="APPLICATIONFOLDER"
      ExeCommand="cmd.exe /c start &quot;&quot; /min &quot;[APPLICATIONFOLDER]GameBot.Service.exe&quot;"
      Execute="immediate"
      Return="asyncNoWait"
      Impersonate="yes" />

    <!-- Feature 163: the bot is a console program with no window. It does not answer the close request of the
         Restart Manager (WM_CLOSE), and a running queue makes it slow to stop. Windows Installer then shows message
         1611, and the nested uninstall of the old product shows the "Files in use" dialog a second time. With the
         value 1, the Restart Manager ends a program that does not answer. This happens only after the owner chose
         "Close the applications" (or in a silent run, which shows no dialog). -->
    <Property Id="MSIRMSHUTDOWN" Value="1" />

    <CustomActionRef Id="ResolveNetworkBinding" />
    <CustomActionRef Id="ValidateNetworkBinding" />
    <CustomActionRef Id="DiscoverBindInterfaces" />
    <!-- Pulls in InstallerProperties.wxs (the protocol search, SetProperty rows). No other element
         references that fragment, so without this line the MSI did not contain it (feature 132). -->
    <CustomActionRef Id="SetApplicationFolder" />
    <UI>
      <DialogRef Id="NetworkConfigDlg" />
      <!-- Every interactive run shows the folder page and then the network page, also an upgrade (feature 162). -->
      <Publish
        Dialog="WelcomeDlg"
        Control="Next"
        Event="NewDialog"
        Value="InstallDirDlg"
        Order="1000"
        Condition="NOT Installed" />
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchBackgroundApp"
        Order="1"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND ((NOT Installed) OR (REINSTALL AND NOT REMOVE~=&quot;ALL&quot;))" />
    </UI>

    <!-- Feature 162: the old product is removed after InstallInitialize, inside the transaction. With the default
         schedule (afterInstallValidate) the removal is not part of the transaction. A failed upgrade then left no
         product, no shortcut, and no registry entry. Now the rollback restores the old product (FR-012). -->
    <MajorUpgrade
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of GameBot is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="GameBot" Level="1">
      <ComponentGroupRef Id="GameBotFiles" />
      <ComponentGroupRef Id="ServicePayloadFiles" />
      <ComponentGroupRef Id="WebUiPayloadFiles" />
      <ComponentGroupRef Id="ShortcutComponents" />
      <ComponentGroupRef Id="DataDirectoryComponents" />
      <ComponentGroupRef Id="StartupRegistrationComponents" />
      <ComponentGroupRef Id="PersistedConfigComponents" />
    </Feature>
  </Package>
</Wix>
