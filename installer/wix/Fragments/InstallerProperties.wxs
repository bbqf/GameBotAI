<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <Property Id="DATA_ROOT" Value="__UNSET__" />
    <Property Id="PROTOCOL" Value="http" />
    <Property Id="PERSISTED_PROTOCOL">
      <RegistrySearch Id="PersistedProtocol" Root="HKCU" Key="Software\GameBot\Network" Name="Protocol" Type="raw" />
    </Property>
    <!-- BIND_HOST and PORT have no default value. An empty value means "not given" (feature 132).
         ResolveNetworkBinding (PortDetection.wxs) sets the final values, and SHORTCUT_URL.
         The saved values are in [DATAROOTFOLDER]config\network.json. -->
    <!-- Registry key (under HKCU) of the older host and port values. The resolver reads them once to
         migrate them, and the commit action deletes them. Only the test variant changes this value. -->
    <Property Id="NETWORK_REGISTRY_ROOT" Value="Software\GameBot\Network" />
    <Property Id="PREFERRED_PORT_ORDER" Value="8080,8088,8888,80" />
    <Property Id="ALLOW_ONLINE_PREREQ_FALLBACK" Value="1" />

    <SetProperty Id="WixAppFolder" Value="WixPerUserFolder" Sequence="both" Before="CostFinalize" />
    <SetProperty Id="ALLUSERS" Value="" Sequence="both" Before="CostFinalize" />
    <SetProperty Id="MSIINSTALLPERUSER" Value="1" Sequence="both" Before="CostFinalize" />

    <!-- A given APPLICATIONFOLDER stays. The Web UI update passes the folder of the existing install,
         so the update finds the data directory (and the saved file) of that install. -->
    <CustomAction Id="SetApplicationFolder" Property="APPLICATIONFOLDER" Value="[LocalAppDataFolder]GameBot" />

    <SetProperty Id="PROTOCOL" Action="SetProtocolFromRegistry" Value="[PERSISTED_PROTOCOL]" Sequence="both" After="AppSearch" Condition="PERSISTED_PROTOCOL &lt;&gt; &quot;&quot;" />
    <SetProperty Id="PROTOCOL" Action="SetProtocolDefault" Value="http" Sequence="both" After="SetProtocolFromRegistry" Condition="PROTOCOL = &quot;&quot;" />

    <InstallUISequence>
      <Custom Action="SetApplicationFolder" Before="CostFinalize" Condition="APPLICATIONFOLDER = &quot;&quot;" />
    </InstallUISequence>

    <InstallExecuteSequence>
      <Custom Action="SetApplicationFolder" Before="CostFinalize" Condition="APPLICATIONFOLDER = &quot;&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
