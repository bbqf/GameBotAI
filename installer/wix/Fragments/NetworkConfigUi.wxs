<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="NetworkConfigDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="20" Transparent="yes" NoPrefix="yes" Text="Configure network settings" />
        <Control Id="Description" Type="Text" X="20" Y="26" Width="330" Height="28" Transparent="yes" NoPrefix="yes" Text="Select the bind interface and the port that GameBot uses. An upgrade shows the saved values." />
        <Control Id="SameBuildHint" Type="Text" X="20" Y="56" Width="330" Height="20" Transparent="yes" NoPrefix="yes" Text="If this build is already installed, setup will prompt for reinstall or cancel." />

        <Control Id="BindHostLabel" Type="Text" X="20" Y="82" Width="150" Height="15" Text="Bind interface:" />
        <Control Id="BindHostCombo" Type="ComboBox" X="180" Y="80" Width="160" Height="18" Property="BIND_HOST" />

        <Control Id="PortLabel" Type="Text" X="20" Y="112" Width="150" Height="15" Text="Port:" />
        <Control Id="PortEdit" Type="Edit" X="180" Y="110" Width="160" Height="18" Property="PORT" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)" />
      </Dialog>

      <!-- ValidateNetworkBinding sets NETWORK_BINDING_ERROR. This dialog shows the text. A new dialog formats its
           text when it opens, so it always shows the current error. A bound control or a static text control on the
           network page does not redraw when a custom action changes the property. -->
      <Dialog Id="NetworkBindingErrorDlg" Width="270" Height="85" Title="[ProductName] Setup">
        <Control Id="ErrorText" Type="Text" X="20" Y="15" Width="235" Height="40" NoPrefix="yes" Text="[NETWORK_BINDING_ERROR]" />
        <Control Id="Ok" Type="PushButton" X="107" Y="60" Width="56" Height="17" Default="yes" Cancel="yes" Text="OK">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <!-- The folder can change the data directory that holds the saved file, so the resolver runs again here. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="ResolveNetworkBinding" Order="99" Condition="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="NetworkConfigDlg" Order="100" Condition="1" />
      <Publish Dialog="NetworkConfigDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Condition="1" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="DoAction" Value="ValidateNetworkBinding" Order="1" Condition="1" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="SpawnDialog" Value="NetworkBindingErrorDlg" Order="2" Condition="NETWORK_BINDING_ERROR &lt;&gt; &quot;&quot;" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="SpawnWaitDialog" Value="WaitForCostingDlg" Order="3" Condition="1" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="EndDialog" Value="Return" Order="4" Condition="NETWORK_BINDING_ERROR = &quot;&quot; AND BIND_HOST &lt;&gt; &quot;&quot; AND PORT &lt;&gt; &quot;&quot; AND OutOfDiskSpace &lt;&gt; 1" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="SpawnDialog" Value="OutOfRbDiskDlg" Order="5" Condition="NETWORK_BINDING_ERROR = &quot;&quot; AND BIND_HOST &lt;&gt; &quot;&quot; AND PORT &lt;&gt; &quot;&quot; AND OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND (PROMPTROLLBACKCOST=&quot;P&quot; OR NOT PROMPTROLLBACKCOST)" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="EndDialog" Value="Return" Order="6" Condition="NETWORK_BINDING_ERROR = &quot;&quot; AND BIND_HOST &lt;&gt; &quot;&quot; AND PORT &lt;&gt; &quot;&quot; AND OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="EnableRollback" Value="False" Order="7" Condition="NETWORK_BINDING_ERROR = &quot;&quot; AND BIND_HOST &lt;&gt; &quot;&quot; AND PORT &lt;&gt; &quot;&quot; AND OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 0 AND PROMPTROLLBACKCOST=&quot;D&quot;" />
      <Publish Dialog="NetworkConfigDlg" Control="Next" Event="SpawnDialog" Value="OutOfDiskDlg" Order="8" Condition="NETWORK_BINDING_ERROR = &quot;&quot; AND BIND_HOST &lt;&gt; &quot;&quot; AND PORT &lt;&gt; &quot;&quot; AND ((OutOfDiskSpace = 1 AND OutOfNoRbDiskSpace = 1) OR (OutOfDiskSpace = 1 AND PROMPTROLLBACKCOST=&quot;F&quot;))" />
      <Publish Dialog="NetworkConfigDlg" Control="Cancel" Event="SpawnDialog" Value="CancelDlg" Condition="1" />

      <ComboBox Property="BIND_HOST">
        <ListItem Text="localhost (127.0.0.1)" Value="127.0.0.1" />
        <ListItem Text="all interfaces (0.0.0.0)" Value="0.0.0.0" />
      </ComboBox>
    </UI>
  </Fragment>
</Wix>
