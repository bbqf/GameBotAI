<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <!-- .jscript extension keeps CodeQL's ECMAScript parser away from MSI-only
         JScript syntax (e.g. Session.Property("X") = "value"); the script engine
         is selected by JScriptCall below, not by the file extension. -->
    <Binary Id="PortResolverScript" SourceFile="Scripts\PortResolver.jscript" />

    <!-- Feature 162: one action decides BIND_HOST, PORT, and SHORTCUT_URL. The priority for each value is:
         explicit value, [DATAROOTFOLDER]config\network.json, older registry value (read once), first-install default.
         DATAROOTFOLDER is valid only after CostFinalize. -->
    <CustomAction
      Id="ResolveNetworkBinding"
      BinaryRef="PortResolverScript"
      JScriptCall="ResolveNetworkBinding"
      Execute="immediate"
      Return="ignore" />

    <!-- Runs on the Next click of the network page. Sets NETWORK_BINDING_ERROR to the error text, or to an empty value. -->
    <CustomAction
      Id="ValidateNetworkBinding"
      BinaryRef="PortResolverScript"
      JScriptCall="ValidateNetworkBinding"
      Execute="immediate"
      Return="ignore" />

    <CustomAction
      Id="DiscoverBindInterfaces"
      BinaryRef="PortResolverScript"
      JScriptCall="DiscoverBindInterfaces"
      Execute="immediate"
      Return="ignore" />

    <!-- The UI run resolves once here and again on the Next click of the folder page.
         The execute run resolves once for a silent run and gives the final values.
         CreateShortcuts runs later, so the shortcut uses the final SHORTCUT_URL. -->
    <InstallUISequence>
      <Custom Action="ResolveNetworkBinding" After="CostFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="DiscoverBindInterfaces" After="ResolveNetworkBinding" Condition="UILevel &gt;= 5 AND NOT REMOVE~=&quot;ALL&quot;" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="ResolveNetworkBinding" After="CostFinalize" Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
  </Fragment>
</Wix>
