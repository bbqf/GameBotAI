function parsePort(value) {
  if (value === null || value === undefined) {
    return -1;
  }

  var text = ("" + value).replace(/^\s+|\s+$/g, "");
  if (text.length === 0 || text.toLowerCase() === "auto") {
    return -1;
  }

  var parsed = parseInt(text, 10);
  if (isNaN(parsed) || parsed < 1 || parsed > 65535) {
    return -1;
  }

  return parsed;
}

function trimText(value) {
  return ("" + value).replace(/^\s+|\s+$/g, "");
}

function appendDebugLog(message) {
  try {
    var shell = new ActiveXObject("WScript.Shell");
    var fso = new ActiveXObject("Scripting.FileSystemObject");
    var logPath = shell.ExpandEnvironmentStrings("%TEMP%\\gamebot_interface_discovery.log");
    var stream = fso.OpenTextFile(logPath, 8, true);
    stream.WriteLine((new Date()).toUTCString() + " | " + message);
    stream.Close();
  }
  catch (ignored) {
  }
}

function parseIpv4(value) {
  var text = trimText(value);
  var match = text.match(/(\d{1,3}(?:\.\d{1,3}){3})/);
  if (!match) {
    return "";
  }

  var candidate = match[1];
  var parts = candidate.split(".");
  if (parts.length !== 4) {
    return "";
  }

  for (var index = 0; index < parts.length; index++) {
    var number = parseInt(parts[index], 10);
    if (isNaN(number) || number < 0 || number > 255) {
      return "";
    }
  }

  return candidate;
}

function parsePortList(csv) {
  var list = [];
  if (!csv) {
    return list;
  }

  var parts = ("" + csv).split(",");
  for (var index = 0; index < parts.length; index++) {
    var port = parsePort(parts[index]);
    if (port > 0) {
      list.push(port);
    }
  }

  return list;
}

// ---------------------------------------------------------------------------
// Port check (feature 162, FR-006).
// The parser and the classifier are pure functions, so tests can run them on sample
// "netstat -ano -p tcp" text. The process lookup is a function that the caller gives.
// ---------------------------------------------------------------------------

var GAMEBOT_SERVICE_EXE = "gamebot.service.exe";

// States that netstat shows for a connection that is not a listener. A listener has the
// foreign port 0. On a Windows with another language, the word LISTENING can differ.
var CONNECTION_STATES = " ESTABLISHED TIME_WAIT CLOSE_WAIT SYN_SENT SYN_RECEIVED SYN_RECV FIN_WAIT_1 FIN_WAIT_2 LAST_ACK CLOSING BOUND ";

// Splits "127.0.0.1:8080" or "[::1]:9000" into { address, port }. Returns null when the text is not valid.
function splitEndpoint(text) {
  var index = text.lastIndexOf(":");
  if (index < 1) {
    return null;
  }

  var port = parseInt(text.substring(index + 1), 10);
  if (isNaN(port) || port < 0 || port > 65535) {
    return null;
  }

  return { address: text.substring(0, index), port: port };
}

// Reads the text of "netstat -ano -p tcp". Returns [{ address, port, pid }] for the listening lines.
// Only the local address counts. A port in the foreign address does not count.
function ParseNetstatListeners(text) {
  var listeners = [];
  var lines = ("" + text).split(/\r?\n/);
  for (var index = 0; index < lines.length; index++) {
    var parts = trimText(lines[index]).split(/\s+/);
    if (parts.length < 5 || parts[0].toUpperCase() !== "TCP") {
      continue;
    }

    var local = splitEndpoint(parts[1]);
    var foreign = splitEndpoint(parts[2]);
    if (local === null || foreign === null || local.port < 1) {
      continue;
    }

    var state = parts[3].toUpperCase();
    var listening = state === "LISTENING" || (foreign.port === 0 && CONNECTION_STATES.indexOf(" " + state + " ") < 0);
    if (!listening) {
      continue;
    }

    listeners.push({ address: local.address, port: local.port, pid: parseInt(parts[4], 10) });
  }

  return listeners;
}

function isWildcardAddress(address) {
  return address === "0.0.0.0" || address === "[::]" || address === "::" || address === "*";
}

// Returns the listeners that block the port for the host.
// A listener on all interfaces blocks every host. A listener on one address blocks the same address.
// A host of 0.0.0.0 (all interfaces) is blocked by every listener on the port.
function MatchListeners(listeners, port, host) {
  var matches = [];
  for (var index = 0; index < listeners.length; index++) {
    var listener = listeners[index];
    if (listener.port !== port) {
      continue;
    }

    if (isWildcardAddress(listener.address) || isWildcardAddress(host) || listener.address === host) {
      matches.push(listener);
    }
  }

  return matches;
}

// True when the process is GameBot.Service.exe and its file is inside the application folder.
function isGameBotService(info, appFolder) {
  if (info === null || info === undefined) {
    return false;
  }

  var folder = normalizeDataPath(appFolder).toLowerCase();
  var name = trimText(info.name).toLowerCase();
  var path = trimText(info.path).toLowerCase();
  return name === GAMEBOT_SERVICE_EXE && folder.length > 0 && path.indexOf(folder) === 0;
}

// Returns { state, pid }. The state is "free", "gamebot" (only the installed bot holds the port),
// or "inuse" (another program holds it, or the owner is not readable).
function ClassifyPortCore(listeners, port, host, appFolder, lookup) {
  var matches = MatchListeners(listeners, port, host);
  var result = { state: "free", pid: 0 };
  for (var index = 0; index < matches.length; index++) {
    var info = null;
    try {
      info = lookup(matches[index].pid);
    }
    catch (ignored) {
      info = null;
    }

    if (isGameBotService(info, appFolder)) {
      result.state = "gamebot";
      result.pid = matches[index].pid;
      continue;
    }

    return { state: "inuse", pid: matches[index].pid };
  }

  return result;
}

// Returns the first candidate that no other program holds. If all are held, returns the first candidate.
function FirstFreePortCore(candidates, listeners, host, appFolder, lookup) {
  for (var index = 0; index < candidates.length; index++) {
    if (ClassifyPortCore(listeners, candidates[index], host, appFolder, lookup).state !== "inuse") {
      return candidates[index];
    }
  }

  return candidates.length > 0 ? candidates[0] : -1;
}

// Returns the error text for the dialog, or "" when the binding is valid.
// The listeners can be an array or a function that returns an array (so that netstat runs only when needed).
function ValidateBindingCore(host, portText, listeners, appFolder, lookup) {
  var port = parsePortText(portText);
  if (port < 1) {
    return "Enter a port number from 1 to 65535.";
  }

  var hostText = trimText(host === null || host === undefined ? "" : host);
  if (!isValidHostText(hostText)) {
    return "Enter a host name or an address with no space, '/' or ':'.";
  }

  var list = typeof listeners === "function" ? listeners() : listeners;
  if (ClassifyPortCore(list, port, hostText, appFolder, lookup).state === "inuse") {
    return "Port " + port + " is in use by another program. Enter a different port.";
  }

  return "";
}

// Runs "netstat -ano -p tcp" once and returns the listeners.
function readNetstatListeners() {
  var shell = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var tempFolder = shell.ExpandEnvironmentStrings("%TEMP%\\");
  var outputPath = tempFolder + "gamebot_portscan_" + (new Date().getTime()) + ".txt";
  shell.Run("%ComSpec% /c netstat -ano -p tcp > \"" + outputPath + "\"", 0, true);

  if (!fso.FileExists(outputPath)) {
    return [];
  }

  var text = "";
  try {
    var file = fso.OpenTextFile(outputPath, 1, false);
    text = file.ReadAll();
    file.Close();
  }
  finally {
    try {
      fso.DeleteFile(outputPath, true);
    }
    catch (ignored) {
    }
  }

  return ParseNetstatListeners(text);
}

// Asks WMI (Win32_Process) for the name and the file of a process. Returns null when it cannot read them.
function lookupProcessWmi(pid) {
  try {
    var locator = new ActiveXObject("WbemScripting.SWbemLocator");
    var service = locator.ConnectServer(".", "root\\cimv2");
    var items = service.ExecQuery("SELECT Name, ExecutablePath FROM Win32_Process WHERE ProcessId = " + parseInt(pid, 10));
    var enumerator = new Enumerator(items);
    if (!enumerator.atEnd()) {
      var item = enumerator.item();
      return { name: "" + item.Name, path: item.ExecutablePath ? "" + item.ExecutablePath : "" };
    }
  }
  catch (ignored) {
  }

  return null;
}

// Returns a lookup function that asks WMI once for each process id.
function createProcessLookup() {
  var cache = {};
  return function (pid) {
    var key = "p" + pid;
    if (!cache.hasOwnProperty(key)) {
      cache[key] = lookupProcessWmi(pid);
    }

    return cache[key];
  };
}

function addInterfaceCandidate(candidates, interfaceName, ipAddress) {
  var name = trimText(interfaceName);
  var ip = parseIpv4(ipAddress);
  if (ip.length === 0 || ip === "127.0.0.1" || ip === "0.0.0.0") {
    return;
  }

  for (var index = 0; index < candidates.length; index++) {
    if (candidates[index].ip === ip) {
      return;
    }
  }

  candidates.push({
    name: name.length > 0 ? name : "interface",
    ip: ip
  });
}

function discoverInterfaceCandidatesPowerShell() {
  var shell = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var tempFolder = shell.ExpandEnvironmentStrings("%TEMP%\\");
  var scriptPath = tempFolder + "gamebot_interfaces_" + (new Date().getTime()) + ".ps1";
  var outputPath = tempFolder + "gamebot_interfaces_ps_" + (new Date().getTime()) + ".txt";
  var scriptContent = "Get-NetIPAddress -AddressFamily IPv4 | "
    + "Where-Object { $_.IPAddress -ne '127.0.0.1' -and $_.IPAddress -ne '0.0.0.0' -and $_.PrefixOrigin -ne 'WellKnown' } | "
    + "Sort-Object InterfaceAlias,IPAddress | "
    + "ForEach-Object { \"$($_.InterfaceAlias)|$($_.IPAddress)\" }";
  var command = "%ComSpec% /c powershell -NoProfile -ExecutionPolicy Bypass -File \""
    + scriptPath
    + "\" > \""
    + outputPath
    + "\"";

  var candidates = [];
  var scriptFile = null;
  try {
    scriptFile = fso.OpenTextFile(scriptPath, 2, true);
    scriptFile.Write(scriptContent);
    scriptFile.Close();
    shell.Run(command, 0, true);
  }
  catch (ignored) {
    appendDebugLog("PowerShell discovery execution failed.");
  }
  finally {
    try {
      if (scriptFile !== null) {
        scriptFile.Close();
      }
    }
    catch (ignoredClose) {
    }

    try {
      if (fso.FileExists(scriptPath)) {
        fso.DeleteFile(scriptPath, true);
      }
    }
    catch (ignoredDelete) {
    }
  }

  if (!fso.FileExists(outputPath)) {
    return candidates;
  }

  var text = "";
  try {
    var file = fso.OpenTextFile(outputPath, 1, false);
    text = file.ReadAll();
    file.Close();
  }
  finally {
    try {
      fso.DeleteFile(outputPath, true);
    }
    catch (ignored) {
    }
  }

  var lines = text.split(/\r?\n/);
  for (var index = 0; index < lines.length; index++) {
    var line = trimText(lines[index]);
    if (line.length === 0 || line.indexOf("|") < 0) {
      continue;
    }

    var parts = line.split("|");
    if (parts.length < 2) {
      continue;
    }

    addInterfaceCandidate(candidates, parts[0], parts[1]);
  }

  return candidates;
}

function discoverInterfaceCandidates() {
  var fromPowerShell = discoverInterfaceCandidatesPowerShell();
  if (fromPowerShell.length > 0) {
    appendDebugLog("PowerShell discovery returned " + fromPowerShell.length + " interface(s).");
    return fromPowerShell;
  }

  appendDebugLog("PowerShell discovery returned 0; falling back to ipconfig parser.");

  var shell = new ActiveXObject("WScript.Shell");
  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var tempFolder = shell.ExpandEnvironmentStrings("%TEMP%\\");
  var outputPath = tempFolder + "gamebot_interfaces_" + (new Date().getTime()) + ".txt";
  var command = "%ComSpec% /c ipconfig > \"" + outputPath + "\"";
  var candidates = [];

  shell.Run(command, 0, true);

  if (!fso.FileExists(outputPath)) {
    return candidates;
  }

  var text = "";
  try {
    var file = fso.OpenTextFile(outputPath, 1, false);
    text = file.ReadAll();
    file.Close();
  }
  finally {
    try {
      fso.DeleteFile(outputPath, true);
    }
    catch (ignored) {
    }
  }

  var lines = text.split(/\r?\n/);
  var currentInterface = "";
  for (var lineIndex = 0; lineIndex < lines.length; lineIndex++) {
    var line = lines[lineIndex] || "";
    var trimmed = trimText(line);

    if (trimmed.length === 0) {
      continue;
    }

    if (/^[^\s].*:\s*$/.test(line)) {
      currentInterface = trimText(trimmed.substring(0, trimmed.length - 1));
      continue;
    }

    if (!currentInterface) {
      continue;
    }

    if (line.indexOf(":") >= 0) {
      addInterfaceCandidate(candidates, currentInterface, line);
    }
  }

  appendDebugLog("ipconfig discovery returned " + candidates.length + " interface(s).");

  return candidates;
}

function describeError(errorObject) {
  if (!errorObject) {
    return "unknown";
  }

  var number = "";
  var description = "";
  try {
    number = errorObject.number;
  }
  catch (ignoredNumber) {
  }

  try {
    description = errorObject.description;
  }
  catch (ignoredDescription) {
  }

  return "number=" + number + ", description=" + description;
}

function insertComboRow(propertyName, order, value, text) {
  var sql = "SELECT `Property`,`Order`,`Value`,`Text` FROM `ComboBox`";
  var view = null;
  try {
    view = Session.Database.OpenView(sql);
    view.Execute();

    var record = Session.Installer.CreateRecord(4);
    record.StringData(1) = propertyName;
    record.IntegerData(2) = order;
    record.StringData(3) = value;
    record.StringData(4) = text;

    view.Modify(7, record);
  }
  finally {
    if (view !== null) {
      view.Close();
    }
  }
}

// Returns the rows for the interface list: the discovered interfaces and, when it is not in the list,
// the current host (for example a saved address that is not found now). The rows for 127.0.0.1 and
// 0.0.0.0 are fixed rows in NetworkConfigUi.wxs.
function InterfaceRowsCore(discovered, currentHost) {
  var rows = [];
  var known = {};
  known["127.0.0.1"] = true;
  known["0.0.0.0"] = true;

  for (var index = 0; index < discovered.length; index++) {
    var item = discovered[index];
    rows.push({ value: item.ip, text: item.name + " (" + item.ip + ")" });
    known[item.ip] = true;
  }

  var current = trimText(currentHost === null || currentHost === undefined ? "" : currentHost);
  if (current.length > 0 && !known.hasOwnProperty(current)) {
    rows.push({ value: current, text: current });
  }

  return rows;
}

function discoverAndPopulateInterfaces() {
  var propertyName = "BIND_HOST";
  if (trimText(Session.Property("BIND_HOST_DISCOVERY_POPULATED")) === "1") {
    appendDebugLog("Discovery rows already populated for this session; skipping.");
    return;
  }

  var rows = InterfaceRowsCore(discoverInterfaceCandidates(), Session.Property("BIND_HOST"));
  appendDebugLog("Populating ComboBox with " + rows.length + " interface row(s).");
  var order = 3;
  for (var index = 0; index < rows.length; index++) {
    appendDebugLog("Adding item: " + rows[index].text);
    try {
      insertComboRow(propertyName, order, rows[index].value, rows[index].text);
    }
    catch (insertErr) {
      appendDebugLog("Insert failed for item: " + rows[index].text + " | " + describeError(insertErr));
    }
    order++;
  }

  Session.Property("BIND_HOST_DISCOVERY_POPULATED") = "1";
}

// Immediate action: fills the interface list of the dialog. Runs after ResolveNetworkBinding.
function DiscoverBindInterfaces() {
  discoverAndPopulateInterfaces();
  return 1;
}

// ---------------------------------------------------------------------------
// Binding resolver (feature 162).
// One rule decides BIND_HOST, PORT, and SHORTCUT_URL. The core functions take plain
// arguments (no Session), so cscript tests can run them.
// ---------------------------------------------------------------------------

var DEFAULT_BIND_HOST = "127.0.0.1";
var DEFAULT_PORT_ORDER = [8080, 8088, 8888, 80];

function textOf(value) {
  return trimText(value === null || value === undefined ? "" : value);
}

// The host in the shortcut: localhost for 127.0.0.1, and the computer name for all other values.
function ShortcutHostCore(bindHost, computerName) {
  var host = textOf(bindHost);
  if (host.length === 0 || host === DEFAULT_BIND_HOST) {
    return "localhost";
  }

  var name = textOf(computerName);
  return name.length > 0 ? name : host;
}

// PROTOCOL://host:port/
function BuildShortcutUrlCore(protocol, bindHost, port, computerName) {
  var scheme = textOf(protocol);
  if (scheme.length === 0) {
    scheme = "http";
  }

  return scheme + "://" + ShortcutHostCore(bindHost, computerName) + ":" + textOf(port) + "/";
}

function readRegistryValue(shell, path) {
  try {
    return shell.RegRead(path);
  }
  catch (ignored) {
    return null;
  }
}

// Reads the older BindHost and Port values under HKCU\<registryRoot>. The caller gives the root. An empty
// root gives nothing, so a test never reads the real key. Never throws. Returns { host, port }.
function ReadLegacyRegistryCore(registryRoot) {
  var result = { host: null, port: null };
  var root = textOf(registryRoot);
  if (root.length === 0) {
    return result;
  }

  var shell = new ActiveXObject("WScript.Shell");
  var host = readRegistryValue(shell, "HKCU\\" + root + "\\BindHost");
  if (host !== null && isValidHostText(textOf(host))) {
    result.host = textOf(host);
  }

  var port = readRegistryValue(shell, "HKCU\\" + root + "\\Port");
  if (port !== null && parsePortText("" + port) > 0) {
    result.port = parsePortText("" + port);
  }

  return result;
}

function validPortOrNull(value) {
  if (value === null || value === undefined) {
    return null;
  }

  var port = parsePortText("" + value);
  return port > 0 ? port : null;
}

function sourceLabel(source) {
  if (source === "Explicit") {
    return "explicit";
  }
  if (source === "NetworkFile") {
    return "network.json";
  }
  if (source === "LegacyRegistry") {
    return "legacy registry, migrated";
  }

  return "default";
}

// Applies the priority for each field on its own: explicit value, network.json, legacy registry, default.
// A value that equals the pre-filled value of an earlier run is not explicit. The input fields are
// host, port, prefillHost, prefillPort, fileHost, filePort, legacyHost, legacyPort, preferredPorts,
// getListeners (function) or listeners (array), appFolder, lookup, protocol, computerName, silent.
// Returns { host, port, hostSource, portSource, prefillHost, prefillPort, shortcutUrl, log }.
function ResolveBindingCore(input) {
  var log = [];
  var preferred = input.preferredPorts && input.preferredPorts.length > 0 ? input.preferredPorts : DEFAULT_PORT_ORDER;
  var lookup = input.lookup ? input.lookup : function () { return null; };
  var getListeners = typeof input.getListeners === "function" ? input.getListeners : function () { return input.listeners ? input.listeners : []; };
  var result = {
    host: "",
    port: "",
    hostSource: "Default",
    portSource: "Default",
    prefillHost: textOf(input.prefillHost),
    prefillPort: textOf(input.prefillPort),
    shortcutUrl: "",
    log: log
  };

  // Host
  var givenHost = textOf(input.host);
  if (givenHost.length > 0 && givenHost !== result.prefillHost) {
    if (isValidHostText(givenHost)) {
      result.host = givenHost;
      result.hostSource = "Explicit";
    }
    else {
      log.push("WARNING: The given BIND_HOST value is not valid. The value is ignored.");
    }
  }

  if (result.host.length === 0) {
    if (isValidHostText(input.fileHost)) {
      result.host = textOf(input.fileHost);
      result.hostSource = "NetworkFile";
    }
    else if (isValidHostText(input.legacyHost)) {
      result.host = textOf(input.legacyHost);
      result.hostSource = "LegacyRegistry";
    }
    else {
      result.host = DEFAULT_BIND_HOST;
      result.hostSource = "Default";
    }
  }

  if (result.hostSource !== "Explicit") {
    result.prefillHost = result.host;
  }

  // Port
  var port = -1;
  var givenPortText = textOf(input.port);
  if (givenPortText.length > 0) {
    var givenPort = parsePortText(givenPortText);
    if (givenPort > 0 && ("" + givenPort) !== result.prefillPort) {
      port = givenPort;
      result.portSource = "Explicit";
    }
    else if (givenPort < 1) {
      log.push("WARNING: The given PORT value is not valid. The value is ignored.");
    }
  }

  if (port < 1) {
    var filePort = validPortOrNull(input.filePort);
    var legacyPort = validPortOrNull(input.legacyPort);
    if (filePort !== null) {
      port = filePort;
      result.portSource = "NetworkFile";
    }
    else if (legacyPort !== null) {
      port = legacyPort;
      result.portSource = "LegacyRegistry";
    }
    else {
      port = FirstFreePortCore(preferred, getListeners(), result.host, textOf(input.appFolder), lookup);
      result.portSource = "Default";
    }
  }

  result.port = "" + port;
  if (result.portSource !== "Explicit") {
    result.prefillPort = result.port;
  }

  log.push("Binding: BIND_HOST=" + result.host + " (source: " + sourceLabel(result.hostSource) + ")");
  log.push("Binding: PORT=" + result.port + " (source: " + sourceLabel(result.portSource) + ")");

  // A silent run has no dialog. It keeps the port and warns when another program holds it (FR-022).
  if (input.silent && result.portSource !== "Default") {
    var check = ClassifyPortCore(getListeners(), port, result.host, textOf(input.appFolder), lookup);
    if (check.state === "inuse") {
      log.push("WARNING: port " + port + " is in use. The " + (result.portSource === "Explicit" ? "given" : "saved") + " port is kept.");
    }
  }

  result.shortcutUrl = BuildShortcutUrlCore(input.protocol, result.host, result.port, input.computerName);
  log.push("Shortcut: " + result.shortcutUrl);

  return result;
}

// Reads the saved file under the data path and the older registry values under the registry root,
// then applies ResolveBindingCore. The log has a warning for each problem in the saved file.
function ResolveWithSavedValuesCore(dataPath, registryRoot, input) {
  var file = ReadNetworkFileCore(dataPath);
  var legacy = ReadLegacyRegistryCore(registryRoot);
  input.fileHost = file.host;
  input.filePort = file.port;
  input.legacyHost = legacy.host;
  input.legacyPort = legacy.port;

  var result = ResolveBindingCore(input);
  var log = [];
  for (var index = 0; index < file.problems.length; index++) {
    log.push("WARNING: " + file.problems[index]);
  }

  result.log = log.concat(result.log);
  return result;
}

// Writes a line to the installer log (information message) and to the debug log.
function logInstaller(message) {
  appendDebugLog(message);
  try {
    var record = Session.Installer.CreateRecord(1);
    record.StringData(0) = "[1]";
    record.StringData(1) = message;
    Session.Message(0x04000000, record);
  }
  catch (ignored) {
  }
}

// Immediate action: sets BIND_HOST, PORT, SHORTCUT_URL, BINDING_PREFILL_HOST, and BINDING_PREFILL_PORT.
// It runs in the UI sequence, on the Next click of the folder page, and in the execute sequence.
// It never fails the install.
function ResolveNetworkBinding() {
  try {
    var listeners = null;
    var result = ResolveWithSavedValuesCore(Session.Property("DATAROOTFOLDER"), Session.Property("NETWORK_REGISTRY_ROOT"), {
      host: Session.Property("BIND_HOST"),
      port: Session.Property("PORT"),
      prefillHost: Session.Property("BINDING_PREFILL_HOST"),
      prefillPort: Session.Property("BINDING_PREFILL_PORT"),
      preferredPorts: parsePortList(Session.Property("PREFERRED_PORT_ORDER")),
      getListeners: function () {
        if (listeners === null) {
          listeners = readNetstatListeners();
        }

        return listeners;
      },
      appFolder: Session.Property("APPLICATIONFOLDER"),
      lookup: createProcessLookup(),
      protocol: Session.Property("PROTOCOL"),
      computerName: Session.Property("ComputerName"),
      silent: parseInt(Session.Property("UILevel"), 10) < 5
    });

    Session.Property("BIND_HOST") = result.host;
    Session.Property("PORT") = result.port;
    Session.Property("SHORTCUT_URL") = result.shortcutUrl;
    Session.Property("BINDING_PREFILL_HOST") = result.prefillHost;
    Session.Property("BINDING_PREFILL_PORT") = result.prefillPort;
    for (var lineIndex = 0; lineIndex < result.log.length; lineIndex++) {
      logInstaller(result.log[lineIndex]);
    }
  }
  catch (errorObject) {
    logInstaller("ResolveNetworkBinding failed: " + describeError(errorObject));
    if (textOf(Session.Property("BIND_HOST")).length === 0) {
      Session.Property("BIND_HOST") = DEFAULT_BIND_HOST;
    }
    if (textOf(Session.Property("PORT")).length === 0) {
      Session.Property("PORT") = "" + DEFAULT_PORT_ORDER[0];
    }
    Session.Property("SHORTCUT_URL") = BuildShortcutUrlCore(
      Session.Property("PROTOCOL"), Session.Property("BIND_HOST"), Session.Property("PORT"), Session.Property("ComputerName"));
  }

  return 1;
}

// Immediate action: checks BIND_HOST and PORT of the dialog. Sets NETWORK_BINDING_ERROR to the error
// text, or to "" when the binding is valid. A failure of the check never blocks the dialog.
function ValidateNetworkBinding() {
  try {
    var error = ValidateBindingCore(
      Session.Property("BIND_HOST"),
      Session.Property("PORT"),
      function () { return readNetstatListeners(); },
      Session.Property("APPLICATIONFOLDER"),
      createProcessLookup());
    Session.Property("NETWORK_BINDING_ERROR") = error;
    if (error.length > 0) {
      logInstaller("Binding check: " + error);
    }
  }
  catch (errorObject) {
    logInstaller("ValidateNetworkBinding failed: " + describeError(errorObject));
    Session.Property("NETWORK_BINDING_ERROR") = "";
  }

  return 1;
}

// ---------------------------------------------------------------------------
// Persisted network settings (feature 132).
// The file is <data path>config\network.json. Each action has a core function
// that takes plain arguments (no Session), so cscript tests can run it.
// ---------------------------------------------------------------------------

var NETWORK_FILE_NAME = "network.json";

// A host is valid when it is not empty, has only visible ASCII characters, and has
// no '/', ':', '"' or '\' character. (The writer only writes ASCII.)
function isValidHostText(host) {
  if (host === null || host === undefined) {
    return false;
  }

  var text = "" + host;
  return /^[\x21-\x7E]+$/.test(text) && !/[\/:"\\]/.test(text);
}

// Returns the port as a number from 1 to 65535, or -1 when the text is not valid.
function parsePortText(text) {
  var value = trimText(text === null || text === undefined ? "" : text);
  if (!/^[0-9]{1,5}$/.test(value)) {
    return -1;
  }

  var parsed = parseInt(value, 10);
  if (parsed < 1 || parsed > 65535) {
    return -1;
  }

  return parsed;
}

// Returns the data path with a trailing backslash, or "" when it is empty.
function normalizeDataPath(dataPath) {
  var text = trimText(dataPath === null || dataPath === undefined ? "" : dataPath);
  if (text.length === 0) {
    return "";
  }

  return text.charAt(text.length - 1) === "\\" ? text : text + "\\";
}

function networkFilePath(basePath) {
  return basePath + "config\\" + NETWORK_FILE_NAME;
}

// True when the text is one JSON object with balanced braces and quotes.
function looksLikeJsonObject(text) {
  var trimmed = trimText(text);
  if (trimmed.length < 2 || trimmed.charAt(0) !== "{" || trimmed.charAt(trimmed.length - 1) !== "}") {
    return false;
  }

  var depth = 0;
  var inString = false;
  for (var index = 0; index < trimmed.length; index++) {
    var ch = trimmed.charAt(index);
    if (inString) {
      if (ch === "\\") {
        index++;
      }
      else if (ch === "\"") {
        inString = false;
      }
    }
    else if (ch === "\"") {
      inString = true;
    }
    else if (ch === "{" || ch === "[") {
      depth++;
    }
    else if (ch === "}" || ch === "]") {
      depth--;
      if (depth < 0) {
        return false;
      }
    }
  }

  return depth === 0 && !inString;
}

function ensureFolder(fso, folder) {
  if (fso.FolderExists(folder)) {
    return;
  }

  var parent = fso.GetParentFolderName(folder);
  if (parent.length > 0 && !fso.FolderExists(parent)) {
    ensureFolder(fso, parent);
  }

  fso.CreateFolder(folder);
}

function deleteFileIfExists(fso, path) {
  if (fso.FileExists(path)) {
    fso.DeleteFile(path, true);
  }
}

// Reads and checks the saved file. Each field is checked on its own.
// Returns { host: string or null, port: number or null, problems: [string] }.
function ReadNetworkFileCore(dataPath) {
  var result = { host: null, port: null, problems: [] };
  var basePath = normalizeDataPath(dataPath);
  if (basePath.length === 0) {
    return result;
  }

  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var path = networkFilePath(basePath);
  if (!fso.FileExists(path)) {
    return result;
  }

  var text = "";
  try {
    var stream = fso.OpenTextFile(path, 1, false);
    text = stream.ReadAll();
    stream.Close();
  }
  catch (readError) {
    result.problems.push("Cannot read " + path + ": " + describeError(readError));
    return result;
  }

  text = text.replace(/^(\xEF\xBB\xBF|\uFEFF)/, "");
  if (!looksLikeJsonObject(text)) {
    result.problems.push("The file " + path + " is not valid JSON. The file is ignored.");
    return result;
  }

  if (/"bindHost"\s*:/.test(text)) {
    var hostMatch = text.match(/"bindHost"\s*:\s*"((?:[^"\\]|\\.)*)"/);
    if (hostMatch && isValidHostText(hostMatch[1])) {
      result.host = hostMatch[1];
    }
    else {
      result.problems.push("The field bindHost in " + path + " is not valid. The value is ignored.");
    }
  }

  if (/"port"\s*:/.test(text)) {
    var portMatch = text.match(/"port"\s*:\s*"([^"]*)"/);
    if (!portMatch) {
      portMatch = text.match(/"port"\s*:\s*(-?[0-9]+(?:\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)/);
    }

    var port = portMatch ? parsePortText(portMatch[1]) : -1;
    if (port > 0) {
      result.port = port;
    }
    else {
      result.problems.push("The field port in " + path + " is not valid. The value is ignored.");
    }
  }

  return result;
}

// Writes the file in the six steps of the plan. A field that is not valid keeps the old value.
// Returns { status: "written" or "skipped", problems: [string] }.
function WriteNetworkFileCore(dataPath, host, port) {
  var result = { status: "skipped", problems: [] };
  var basePath = normalizeDataPath(dataPath);
  if (basePath.length === 0) {
    result.problems.push("The data path is empty. Nothing is written.");
    return result;
  }

  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var path = networkFilePath(basePath);
  var backupPath = path + ".bak";
  var noneMarkerPath = path + ".none";
  var tempPath = path + ".tmp";

  // 1. Create the config folder.
  ensureFolder(fso, basePath + "config");

  // 2. Check the new values.
  var newHost = trimText(host === null || host === undefined ? "" : host);
  var newPort = parsePortText(port);
  if (!isValidHostText(newHost)) {
    result.problems.push("The host is not valid. The old value is kept.");
    newHost = null;
  }
  if (newPort < 1) {
    result.problems.push("The port is not valid. The old value is kept.");
    newPort = null;
  }
  if (newHost === null && newPort === null) {
    return result;
  }

  // 3. Recover from a hard stop of a former run.
  if (fso.FileExists(backupPath)) {
    fso.CopyFile(backupPath, path, true);
    deleteFileIfExists(fso, backupPath);
  }
  deleteFileIfExists(fso, noneMarkerPath);
  deleteFileIfExists(fso, tempPath);

  var old = ReadNetworkFileCore(basePath);
  var finalHost = newHost !== null ? newHost : old.host;
  var finalPort = newPort !== null ? newPort : old.port;

  // 4. Make the undo marker.
  if (fso.FileExists(path)) {
    fso.CopyFile(path, backupPath, true);
  }
  else {
    fso.CreateTextFile(noneMarkerPath, true, false).Close();
  }

  // 5. Write the full new content to the temporary file (ASCII, no byte order mark).
  var fields = [];
  if (finalHost !== null) {
    fields.push("  \"bindHost\": \"" + finalHost + "\"");
  }
  if (finalPort !== null) {
    fields.push("  \"port\": \"" + finalPort + "\"");
  }
  var content = "{\r\n" + fields.join(",\r\n") + "\r\n}\r\n";
  var tempFile = fso.CreateTextFile(tempPath, true, false);
  tempFile.Write(content);
  tempFile.Close();

  // 6. Replace the file.
  deleteFileIfExists(fso, path);
  fso.MoveFile(tempPath, path);

  result.status = "written";
  return result;
}

// Restores the old state and removes the temporary files. Safe to run again.
function RollbackNetworkFileCore(dataPath) {
  var basePath = normalizeDataPath(dataPath);
  if (basePath.length === 0) {
    return;
  }

  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var path = networkFilePath(basePath);
  var backupPath = path + ".bak";
  var noneMarkerPath = path + ".none";

  if (fso.FileExists(backupPath)) {
    fso.CopyFile(backupPath, path, true);
  }
  else if (fso.FileExists(noneMarkerPath)) {
    deleteFileIfExists(fso, path);
  }

  deleteFileIfExists(fso, path + ".tmp");
  deleteFileIfExists(fso, backupPath);
  deleteFileIfExists(fso, noneMarkerPath);
}

// Deletes the older BindHost and Port values under HKCU\<registryRoot>. Keeps the other values (Protocol).
// An empty root deletes nothing. Never throws.
function DeleteLegacyRegistryCore(registryRoot) {
  var root = textOf(registryRoot);
  if (root.length === 0) {
    return;
  }

  var shell = new ActiveXObject("WScript.Shell");
  var names = ["BindHost", "Port"];
  for (var index = 0; index < names.length; index++) {
    try {
      shell.RegDelete("HKCU\\" + root + "\\" + names[index]);
    }
    catch (ignored) {
    }
  }
}

// Removes the temporary files. Never changes the file itself. After the file is written, the older registry
// values are not needed any more, so this step deletes them (feature 162). Rollback never deletes them.
function CommitNetworkFileCore(dataPath, registryRoot) {
  var basePath = normalizeDataPath(dataPath);
  if (basePath.length === 0) {
    return;
  }

  var fso = new ActiveXObject("Scripting.FileSystemObject");
  var path = networkFilePath(basePath);
  deleteFileIfExists(fso, path + ".tmp");
  deleteFileIfExists(fso, path + ".bak");
  deleteFileIfExists(fso, path + ".none");
  DeleteLegacyRegistryCore(registryRoot);
}

// Splits the CustomActionData of the write action: data path, host, port.
// Returns null when the part count is not 3 or the data path is empty.
function SplitWriteData(data) {
  var parts = ("" + (data === null || data === undefined ? "" : data)).split("|");
  if (parts.length !== 3 || trimText(parts[0]).length === 0) {
    return null;
  }

  return { dataPath: parts[0], host: parts[1], port: parts[2] };
}

// Splits the CustomActionData of the commit action: data path, and optionally the registry root.
function SplitCommitData(data) {
  var parts = ("" + (data === null || data === undefined ? "" : data)).split("|");
  return { dataPath: parts[0], registryRoot: parts.length > 1 ? parts[1] : "" };
}

// Deferred action. CustomActionData is "<data path>|<host>|<port>". Never fails the install.
function WritePersistedNetworkFile() {
  try {
    var parts = SplitWriteData(Session.Property("CustomActionData"));
    if (parts === null) {
      appendDebugLog("WritePersistedNetworkFile: the action data is not valid. Nothing is written.");
      return 1;
    }

    var result = WriteNetworkFileCore(parts.dataPath, parts.host, parts.port);
    for (var index = 0; index < result.problems.length; index++) {
      appendDebugLog("WritePersistedNetworkFile: " + result.problems[index]);
    }
  }
  catch (errorObject) {
    appendDebugLog("WritePersistedNetworkFile failed: " + describeError(errorObject));
  }

  return 1;
}

// Rollback action. CustomActionData is the data path. Never fails the install.
function RollbackPersistedNetworkFile() {
  try {
    RollbackNetworkFileCore(Session.Property("CustomActionData"));
  }
  catch (errorObject) {
    appendDebugLog("RollbackPersistedNetworkFile failed: " + describeError(errorObject));
  }

  return 1;
}

// Commit action. CustomActionData is "<data path>|<registry root>". Never fails the install.
function CommitPersistedNetworkFile() {
  try {
    var parts = SplitCommitData(Session.Property("CustomActionData"));
    CommitNetworkFileCore(parts.dataPath, parts.registryRoot);
  }
  catch (errorObject) {
    appendDebugLog("CommitPersistedNetworkFile failed: " + describeError(errorObject));
  }

  return 1;
}
