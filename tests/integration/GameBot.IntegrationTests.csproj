<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CA1515</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <CoverletOutputFormat>cobertura</CoverletOutputFormat>
    <ExcludeByFile>**/PlatformSupport.cs;**/GlobalSuppressions.cs</ExcludeByFile>
    <CoverletOutput>$(MSBuildProjectDirectory)\TestResults\coverage\</CoverletOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.8">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ReportGenerator" Version="5.4.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- Feature 120: the notification fakes are shared with the unit tests. -->
    <Compile Include="..\unit\Notifications\NotificationTestSupport.cs" Link="Notifications\NotificationTestSupport.cs" />
    <!-- Feature 131: the update fakes are shared with the unit tests. -->
    <Compile Include="..\unit\Updates\UpdateTestSupport.cs" Link="Updates\UpdateTestSupport.cs" />
    <!-- Feature 143: the gamepack builders and the test gate are shared with the unit tests. -->
    <Compile Include="..\unit\Gamepacks\GamepackTestKit.cs" Link="Gamepacks\GamepackTestKit.cs" />
    <!-- Feature 151: the step fixtures are shared with the unit tests. -->
    <Compile Include="..\unit\Gamepacks\GamepackStepFixtures.cs" Link="Gamepacks\GamepackStepFixtures.cs" />
    <!-- Feature 147: the catalog test server and fixture are shared with the unit tests. -->
    <Compile Include="..\unit\Gamepacks\CatalogTestKit.cs" Link="Gamepacks\CatalogTestKit.cs" />
    <!-- Feature 146: the test signer is shared with the unit tests. -->
    <Compile Include="..\unit\Gamepacks\Signing\SigningTestKit.cs" Link="Gamepacks\Signing\SigningTestKit.cs" />
    <!-- Feature 145: the queue settings test doubles are shared with the unit tests. -->
    <Compile Include="..\unit\QueueSettings\TestDoubles\*.cs" Link="QueueSettings\TestDoubles\%(Filename)%(Extension)" />
    <!-- Feature 148: the managed update fakes are shared with the unit tests. -->
    <Compile Include="..\unit\Gamepacks\Managed\FakeManagedQueueControl.cs" Link="Gamepacks\Managed\FakeManagedQueueControl.cs" />
    <Compile Include="..\unit\Gamepacks\Managed\ManagedTestRig.cs" Link="Gamepacks\Managed\ManagedTestRig.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GameBot.Service\GameBot.Service.csproj" />
    <ProjectReference Include="..\TestAssets\TesseractStub\TesseractStub.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
